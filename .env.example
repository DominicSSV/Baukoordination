# =============================================================================
# Baukoordination – Umgebungsvariablen
#
# Für die lokale Entwicklung diese Datei nach .env.local kopieren und ausfüllen.
# .env.local steht in .gitignore und darf NIE eingecheckt werden.
# Auf Vercel dieselben Werte unter Settings > Environment Variables hinterlegen.
# =============================================================================

# --- Pflicht: Supabase -------------------------------------------------------
# Dashboard > Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Dashboard > Project Settings > API Keys > anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dashboard > Project Settings > API Keys > service_role
# ACHTUNG: umgeht alle RLS-Regeln. Nur serverseitig, niemals ins Frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Dringend empfohlen: RLS für Lieferanten ---------------------------------
# Dashboard > Project Settings > JWT Keys > JWT Secret (Legacy / HS256).
# Damit signiert der Server die kurzlebigen Lieferanten-Tokens. Fehlt der Wert,
# greifen für Lieferanten nur die Prüfungen der App, nicht zusätzlich die
# RLS-Policies der Datenbank – die App weist dann oben sichtbar darauf hin.
SUPABASE_JWT_SECRET=

# --- Optional: automatischer Mailversand (Resend) ----------------------------
# Ohne Schlüssel bietet die App weiterhin Kopiertext und mailto-Link an.
RESEND_API_KEY=
MAIL_FROM=Baukoordination Swiss Solar Ventures <baukoordination@deine-domain.ch>

# Benachrichtigung bei JEDER einzelnen Aktivität an alle Projektbeteiligten.
# Standard: an. Auf false setzen, falls im Betrieb zu viel Post entsteht – dann
# bleibt nur die gesammelte Zusammenfassung über den Knopf "Update senden".
NOTIFY_ON_EVERY_ACTIVITY=true

# --- Optional: Basis-URL für Links in E-Mails --------------------------------
# Auf Vercel wird sie automatisch erkannt; lokal bzw. bei eigener Domain setzen.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Antwortadresse für alle Mails. Sinnvoll, wenn als Absender eine Unter-Domain
# dient (z.B. baukoordination@mail.swiss-sv.ch), Antworten aber in einem echten
# Postfach landen sollen.
MAIL_REPLY_TO=baukoordination@swiss-sv.ch

# Schützt den täglichen Prüflauf auf überschrittene Fristen. Vercel schickt den
# Wert automatisch mit; frei wählbare, lange Zeichenkette.
CRON_SECRET=
